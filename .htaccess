<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirige la racine (/) vers public/index.php (page d'accueil)
    RewriteRule ^$ public/index.php [L]

    # Si la requête cible un fichier ou dossier existant dans public/, on laisse passer
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Pour toutes les autres requêtes (ex: /produit, /boutique, /cart, etc.)
    # on réécrit vers public/index.php?url=...
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
</IfModule>