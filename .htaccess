<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Si la requête est exactement la racine → redirige vers /public/
    RewriteRule ^$ public/ [L]

    # Ne redirige que si la cible n'est ni un fichier ni un dossier existant,
    # et si elle ne commence pas déjà par /public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>