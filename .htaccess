RewriteEngine On

# Servir directement les fichiers dans public/
RewriteCond %{REQUEST_URI} ^/(.+)$
RewriteCond %{DOCUMENT_ROOT}/public/%1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public/%1 -d
RewriteRule ^(.+)$ public/$1 [L]

# Rediriger la racine (/) vers public/index.php
RewriteRule ^$ public/index.php [L]

# Pour toutes les autres requêtes (qui n'existent pas dans public/), on réécrit vers public/index.php (router)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]

